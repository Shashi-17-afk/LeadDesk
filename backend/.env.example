# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# SERVICE ROLE KEY — grants full DB access, bypasses RLS.
# Found in: Supabase Dashboard → Settings → API → service_role (secret)
# ⚠️  Never commit the real value. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=replace-this-with-a-secure-random-string-at-least-32-chars

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make cross-origin requests
FRONTEND_URL=http://localhost:5173
